# /etc/stui/stui.env （各ノードで NODE_ID だけ変える。権限 0600, 所有者 stui）
DATABASE_URL=jdbc:postgresql://10.0.0.11:5432,10.0.0.12:5432,10.0.0.13:5432/stui?targetServerType=primary&connectTimeout=3&tcpKeepAlive=true
DATABASE_USER=stui
DATABASE_PASSWORD=change-me
OIDC_ISSUER=https://auth.example.com/application/o/stui/
OIDC_CLIENT_ID=change-me
OIDC_CLIENT_SECRET=change-me
PUBLIC_URL=https://stui.example.com
ADMIN_GROUPS=stui-admins
STATIC_DIR=/opt/stui/current/static
HTTP_PORT=8080
# ノード名（ログ・定期処理のリースに使う）
NODE_ID=stui1
# 秘密の値の暗号化（兄弟のサービスの OAuth トークン）。全ノード共通、16文字以上。変えると保存済みの値を読めなくなる
APP_SECRET=change-me-32-random-chars-same-on-all-nodes
TIMEZONE=Asia/Tokyo
# 添付（S3 互換ストレージ。各VMで動かす場合は VIP 経由の HAProxy で3台に分散）
S3_ENDPOINT=http://10.0.0.10:7480
S3_BUCKET=stui
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
MAX_UPLOAD_MB=100
# メール（SMTPサーバー）
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USER=stui@example.com
SMTP_PASSWORD=change-me
MAIL_FROM=stui@example.com
# メールは通知から少し待って、画面で読まれなかったときだけ送る（分）
MAIL_DELAY_MINUTES=10
# stui を使う兄弟のサービス（通知を送る・メッセージの名前を出す）。docs/integrations.md
#OAUTH_CLIENTS=[{"id":"skea","secret":"…16文字以上…","redirectUri":"https://skea.example.com/api/integrations/stui/callback","name":"skea","scopes":["read","write"]}]
# stui から兄弟のサービスを使う（リンクの名前・会議室の作成）。相手に client_id=stui を登録しておく
#SKIWI_URL=https://wiki.example.com
#SKIWI_CLIENT_ID=stui
#SKIWI_CLIENT_SECRET=change-me
#SKAWAU_URL=https://files.example.com
#SKAWAU_CLIENT_ID=stui
#SKAWAU_CLIENT_SECRET=change-me
#SKEA_URL=https://tasks.example.com
#SKEA_CLIENT_ID=stui
#SKEA_CLIENT_SECRET=change-me
#SKAKA_URL=https://meet.example.com
#SKAKA_CLIENT_ID=stui
#SKAKA_CLIENT_SECRET=change-me
